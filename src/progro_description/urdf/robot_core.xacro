<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="progro">
    <link name="world"></link>

    <joint name="world_to_base" type="fixed">
        <parent link="world" />
        <child link="base_link" />
        <origin rpy="0 0 0" xyz="0 0 0" />
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
            <geometry>
                <box size="0.25 0.25 0.5" />
            </geometry>
            <material name="grey" />
        </visual>
        <collision>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
            <geometry>
                <box size="0.25 0.25 0.5" />
            </geometry>
        </collision>
        <xacro:inertial_box mass="5.0" x="0.25" y="0.25" z="0.5">
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="base_to_shoulder" type="continuous">
        <parent link="base_link" />
        <child link="shoulder_socket" />
        <origin rpy="0 0 0" xyz="0 0 0.5" />
        <axis rpy="0 0 0" xyz="0 0 1" />
    </joint>

    <link name="shoulder_socket">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.15" />
            </geometry>
            <material name="grey" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.15" />
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="1.0" radius="0.15">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

    <joint name="shoulder" type="revolute">
        <parent link="shoulder_socket" />
        <child link="bicep" />
        <origin rpy="0 0 0" xyz="0 0 0" />
        <axis rpy="0 0 0" xyz="0 1 0" />
        <limit effort="10.0" lower="-${pi/2}" upper="${pi/2}" velocity="1.0"/>
    </joint>

    <link name="bicep">
        <visual>
            <origin xyz="0 0 0.4" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.8"/>
            </geometry>
            <material name="white" />
        </visual>
        <collision>
            <origin xyz="0 0 0.4" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.8"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="1.5" length="0.8" radius="0.05">
            <origin xyz="0 0 0.4" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="elbow" type="revolute">
        <parent link="bicep" />
        <child link="forearm" />
        <origin rpy="0 0 0" xyz="0 0 0.8" />
        <axis rpy="0 0 0" xyz="0 1 0" />
        <limit effort="10.0" lower="-${pi/2}" upper="${pi/2}" velocity="1.0"/>
    </joint>

    <link name="forearm">
        <visual>
            <origin xyz="0 0 0.3" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.04" length="0.6"/>
            </geometry>
            <material name="white" />
        </visual>
        <collision>
            <origin xyz="0 0 0.3" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.04" length="0.6"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="1.0" length="0.6" radius="0.04">
            <origin xyz="0 0 0.3" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="wrist" type="revolute">
        <parent link="forearm" />
        <child link="hand" />
        <origin rpy="0 0 0" xyz="0 0 0.6" />
        <axis rpy="0 0 0" xyz="0 1 0" />
        <limit effort="5.0" lower="-${pi/2}" upper="${pi/2}" velocity="1.0"/>
    </joint>

    <link name="hand">
        <visual>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <geometry>
                <box size="0.1 0.1 0.15"/>
            </geometry>
            <material name="grey" />
        </visual>
        <collision>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <geometry>
                <box size="0.1 0.1 0.15"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.5" x="0.1" y="0.1" z="0.15">
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="hand_to_camera" type="fixed">
        <parent link="hand" />
        <child link="camera" />
        <origin rpy="0 -1.5708 0" xyz="0.05 0 0.075" />
    </joint>

    <link name="camera">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.022" radius="0.015" />
            </geometry>
            <material name="blue" />
        </visual>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.06 0.04 0.02" />
            </geometry>
            <material name="gray" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.06 0.04 0.05" />
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.1" x="0.04" y="0.04" z="0.06">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

</robot>